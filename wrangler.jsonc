{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heyflare",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "heyflare-db", "database_id": "c7a3b1ee-1763-4cfc-b39d-610378bd2738", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_NAME": "heyflare",
    "WORKER_NAME": "heyflare",
    "APP_URL": "https://hey.ilyasy.com"
  },
  "routes": [
    { "pattern": "hey.ilyasy.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
